{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,js,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,js,mjs,ts}\"",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && node --input-type=module -e \"import('./dist/config_loader.js').then(({loadConfig})=>{if(typeof loadConfig!=='function')throw new Error('Build missing loader export')})\"",
    "verify": "yarn format:check && yarn lint && yarn typecheck && yarn test && yarn build"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.7",
    "vitest": "5.1.1"
  }
}
