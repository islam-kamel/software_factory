{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "format": "prettier \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,mjs}\" --write",
    "format:check": "prettier \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,mjs}\" --check",
    "lint": "eslint \"src/engine/*.ts\" \"tests/unit/*.ts\"",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "test": "vitest run",
    "build": "node node_modules/typescript7/bin/tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "26.0.0",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "6.0.2",
    "typescript7": "npm:typescript@7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.6"
  }
}
