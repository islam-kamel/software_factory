# .env.example — Software Factory
# Copy this file to `.env` (gitignored) and fill in your real credentials.
# Never commit `.env` or hardcode secrets inside YAML config files.

# ------------------------------------------------------------------------------
# 1. LLM Providers (referenced by `api_key_env` in config/models.yaml)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 2. Issue Trackers & Git Hosts (referenced by `token_env` in config/repos.yaml)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=

# Optional per-repo / per-client tokens (see config/repos.example.yaml)
CLIENT_DASHBOARD_GH_TOKEN=
FINTECH_GH_TOKEN=

# Optional alternative tracker/git host adapters
GITLAB_TOKEN=
JIRA_API_TOKEN=

# ------------------------------------------------------------------------------
# 3. Notifications (used by src/adapters/notifier/)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional alternative notification channels
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
